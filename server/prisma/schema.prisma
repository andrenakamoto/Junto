datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(cuid())
  pseudo               String    @unique
  // Prénom obligatoire à l'inscription (contrôlé par l'API), nom facultatif.
  // Nullable en base : les comptes créés avant le 2026-09-27 n'en ont pas.
  firstName            String?
  lastName             String?
  password             String?
  email                String?   @unique
  emailVerified        Boolean   @default(false)
  googleId             String?   @unique
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  // Changement d'email en attente : l'ancienne adresse reste active jusqu'au clic sur le lien
  // envoyé à la nouvelle (24 h) — lib/emailChange.ts
  pendingEmail         String?
  pendingEmailToken    String?   @unique
  pendingEmailExpires  DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  status               String    @default("approved")
  isAdmin              Boolean   @default(false)
  acceptedTermsVersion Int       @default(0)
  weeklyDigestEnabled  Boolean   @default(true)
  // Canal des notifications (lib/notificationPrefs.ts) : push | both | email. N'affecte ni les
  // emails indispensables (validation, mot de passe…) ni les notifications dans l'app.
  notificationChannel  String    @default("both")
  // Réponse à un Plan sans compte (lib/lightGuest.ts) : prénom seulement, pseudo « prenom.invite »,
  // ni email ni mot de passe. Devient un compte normal à l'inscription, ou est fusionné dans le
  // compte existant à la connexion ; supprimé quand il n'a plus aucun Plan.
  isLight              Boolean   @default(false)
  lastDigestSentAt     DateTime?
  createdAt            DateTime  @default(now())
  // Dernière utilisation de l'app (au plus une mise à jour par heure, lib/activity.ts) —
  // sert uniquement au total « membres actifs » du panneau admin
  lastActiveAt         DateTime?

  memberships            CircleMember[]
  planMemberships        PlanMember[]
  messages               Message[]
  messageReactions       MessageReaction[]
  createdCircles         Circle[]              @relation("CircleCreator")
  createdPlans           Plan[]                @relation("PlanCreator")
  pollVotes              PollVote[]
  deleteVotes            CircleDeleteVote[]
  planDeleteVotes        PlanDeleteVote[]
  expensesPaid           Expense[]             @relation("ExpensePaidBy")
  expenseShares          ExpenseShare[]
  reimbursementsSent     Reimbursement[]       @relation("ReimbursementFrom")
  reimbursementsReceived Reimbursement[]       @relation("ReimbursementTo")
  circleJoinRequests     CircleJoinRequest[]
  circleJoinVotes        CircleJoinVote[]
  circlePollsCreated     CirclePoll[]          @relation("CirclePollCreator")
  circlePollVotes        CirclePollVote[]
  ridesDriven            Ride[]                @relation("RideDriver")
  ridePassengers         RidePassenger[]
  rideRequests           RideRequest[]
  planExclusions         PlanExclusion[]
  planChangeLogs         PlanChangeLog[]       @relation("PlanChangeLogAuthor")
  circlePollExclusions   CirclePollExclusion[] @relation("CirclePollExclusions")
  circlePollDeclines     CirclePollDecline[]   @relation("CirclePollDeclines")
  circlePollMessages     CirclePollMessage[]   @relation("CirclePollMessages")
  pushTokens             PushToken[]
  reportsMade            MessageReport[]       @relation("ReportReporter")
  reportsReceived        MessageReport[]       @relation("ReportAuthor")
  suggestions            Suggestion[]
  blocking               UserBlock[]           @relation("BlockBy")
  blockedBy              UserBlock[]           @relation("BlockTarget")
  circleInvitesSent      CircleInvitation[]    @relation("InviteFrom")
  circleInvitesReceived  CircleInvitation[]    @relation("InviteTo")
  circleChangeLogs       CircleChangeLog[]     @relation("CircleChangeLogAuthor")

  @@index([lastActiveAt])
}

// Notifications push des apps Android / iOS (lib/push.ts) : un jeton Firebase par
// appareil, rattaché au dernier compte connecté sur cet appareil. Supprimé à la
// déconnexion, ou quand Firebase le signale comme expiré.
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String // android | ios
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Circle {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  description      String?
  color            String?
  createdAt        DateTime @default(now())
  // Cercle personnel « Mes Plans » (Plans express, lib/express.ts) : un par personne
  isPersonal       Boolean  @default(false)
  // Paramètres avancés : "vote" (majorité) ou "creator" ; admission aussi "open" (code seul)
  deletionMode     String   @default("vote")
  admissionMode    String   @default("vote")
  // Qui peut créer des Plans et des sondages de dates : "all" (tous les membres) ou "creator"
  planCreationMode String   @default("all")
  // Qui peut lancer des sondages de dates : 'all' ou 'creator' (créateur et organisateurs)
  pollCreationMode String   @default("all")

  creatorId    String
  creator      User                @relation("CircleCreator", fields: [creatorId], references: [id])
  members      CircleMember[]
  plans        Plan[]
  deleteVotes  CircleDeleteVote[]
  joinRequests CircleJoinRequest[]
  polls        CirclePoll[]
  invitations  CircleInvitation[]
  changeLogs   CircleChangeLog[]
}

// Sondage pour caler une date (ou autre choix) avant de créer un Plan.
// Contrairement à Poll (qui appartient à un Plan déjà créé et n'autorise
// qu'un choix par personne), CirclePoll vit au niveau du Cercle et permet
// un vote multiple (ex. "je suis dispo le 12 ET le 15").
model CirclePoll {
  id             String    @id @default(cuid())
  question       String
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  // Rappel « ton sondage se termine demain » envoyé au créateur (anti-doublon)
  reminderSentAt DateTime?

  circleId  String
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User   @relation("CirclePollCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  createdPlanId String? @unique
  createdPlan   Plan?   @relation(fields: [createdPlanId], references: [id])

  options    CirclePollOption[]
  exclusions CirclePollExclusion[]
  declines   CirclePollDecline[]
  messages   CirclePollMessage[]
}

// Sondage surprise : membres du Cercle pour qui le sondage n'existe pas
model CirclePollExclusion {
  pollId String
  poll   CirclePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation("CirclePollExclusions", fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
}

// « Pas intéressé(e) » — exclusif avec les votes (déclarer l'un efface l'autre)
model CirclePollDecline {
  createdAt DateTime   @default(now())
  pollId    String
  poll      CirclePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("CirclePollDeclines", fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
}

// Chat du sondage (recopié dans le chat du Plan lors de la conversion)
model CirclePollMessage {
  id        String     @id @default(cuid())
  content   String
  createdAt DateTime   @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  pollId    String
  poll      CirclePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation("CirclePollMessages", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([pollId, createdAt])
}

model CirclePollOption {
  id        String    @id @default(cuid())
  label     String
  eventDate DateTime?

  pollId String
  poll   CirclePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  CirclePollVote[]
}

model CirclePollVote {
  votedAt DateTime @default(now())

  optionId String
  option   CirclePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
}

model CircleJoinRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  circleId String
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  votes CircleJoinVote[]

  @@unique([circleId, userId])
}

model CircleJoinVote {
  votedAt DateTime @default(now())

  requestId String
  request   CircleJoinRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, userId])
}

model CircleDeleteVote {
  userId   String
  circleId String
  votedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
}

model CircleMember {
  userId   String
  circleId String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@id([userId, circleId])
}

model Plan {
  id                String    @id @default(cuid())
  title             String
  description       String
  eventDate         DateTime?
  endDate           DateTime
  location          String?
  archived          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  reminderSentAt    DateTime?
  maxParticipants   Int?
  // Paramètres avancés : suppression "vote" ou "creator" ; fonctions masquées (chat, trajets, votes, depenses, fichiers)
  deletionMode      String    @default("vote")
  disabledFeatures  String[]  @default([])
  // "creator" : seul le créateur modifie ; "all" : les membres du Plan (hors invités) modifient dates et lieu
  editMode          String    @default("creator")
  // Informations importantes (affichées après la description) et qui peut les modifier :
  // "creator" (créateur du Plan) ou "all" (tous les participants) — indépendant de editMode
  importantInfo     String?
  importantInfoMode String    @default("creator")

  creatorId String
  creator   User   @relation("PlanCreator", fields: [creatorId], references: [id])
  circleId  String
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  members          PlanMember[]
  activities       PlanActivity[]
  messages         Message[]
  polls            Poll[]
  items            BringItem[]
  deleteVotes      PlanDeleteVote[]
  changeLogs       PlanChangeLog[]
  attachments      Attachment[]
  expenses         Expense[]
  reimbursements   Reimbursement[]
  originCirclePoll CirclePoll?
  rides            Ride[]
  rideRequests     RideRequest[]
  exclusions       PlanExclusion[]
  guestLink        PlanGuestLink?
}

// Lien d'invitation « invité externe » d'un Plan (réutilisable, régénérable par le
// créateur). Table séparée pour que le jeton ne remonte jamais avec les champs du Plan.
model PlanGuestLink {
  planId    String   @id
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
}

// Plan surprise : membres du Cercle pour qui le Plan est totalement invisible
model PlanExclusion {
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([planId, userId])
}

// Covoiturage : un conducteur propose un trajet aller (un seul par Plan)
model Ride {
  id          String    @id @default(cuid())
  departure   String
  departureAt DateTime?
  seats       Int
  note        String?
  createdAt   DateTime  @default(now())

  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  driverId String
  driver   User   @relation("RideDriver", fields: [driverId], references: [id], onDelete: Cascade)

  passengers RidePassenger[]

  @@unique([planId, driverId])
}

// planId dupliqué ici pour que la base garantisse un seul trajet par passager et par Plan
model RidePassenger {
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  createdAt DateTime @default(now())

  @@id([rideId, userId])
  @@unique([planId, userId])
}

// « Je cherche une place » — une demande par membre et par Plan
model RideRequest {
  id           String   @id @default(cuid())
  fromLocation String
  createdAt    DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  // Devise de la dépense : 'CHF' (défaut) ou 'EUR'. Soldes calculés séparément par devise, sans conversion
  currency    String   @default("CHF")
  createdAt   DateTime @default(now())

  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  paidById String
  paidBy   User   @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)

  splitWith ExpenseShare[]
}

model ExpenseShare {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
}

model Reimbursement {
  id        String   @id @default(cuid())
  amount    Float
  currency  String   @default("CHF")
  createdAt DateTime @default(now())

  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User   @relation("ReimbursementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("ReimbursementTo", fields: [toUserId], references: [id], onDelete: Cascade)
}

model PlanChangeLog {
  id          String   @id @default(cuid())
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  field       String
  oldValue    String?
  newValue    String?
  changedAt   DateTime @default(now())
  // Auteur de la modification (null pour l'historique antérieur ou un compte supprimé)
  changedById String?
  changedBy   User?    @relation("PlanChangeLogAuthor", fields: [changedById], references: [id], onDelete: SetNull)
}

model Attachment {
  id           String   @id @default(cuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  name         String
  url          String
  publicId     String
  resourceType String   @default("raw")
  mimeType     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())
  // Message du chat qui affiche cette photo (photo envoyée depuis le chat)
  message      Message?
}

model PlanDeleteVote {
  userId  String
  planId  String
  votedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([userId, planId])
}

model PlanMember {
  userId   String
  planId   String
  rsvp     String   @default("in")
  joinedAt DateTime @default(now())
  // Dernière consultation de chaque onglet du Plan : { chat: ISO, infos: ISO, … } — lib/planActivity.ts
  seen     Json     @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([userId, planId])
}

// Dernière activité de chaque onglet d'un Plan (chat, infos, trajets, membres, votes,
// depenses) : seulement une date, pour afficher les pastilles « nouveau »
model PlanActivity {
  planId  String
  section String
  at      DateTime

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, section])
}

model Message {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  // Modifiable / supprimable par son auteur pendant 15 min (lib/messageEdit.ts). Supprimé :
  // le contenu est effacé, le message reste pour garder le fil lisible (« Message supprimé »)
  editedAt  DateTime?
  deletedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("MessageReplies")

  // Photo envoyée dans le chat (aussi visible dans l'onglet Infos) — null si retirée depuis Infos
  attachmentId String?     @unique
  attachment   Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  reactions MessageReaction[]
}

model MessageReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Poll {
  id        String   @id @default(cuid())
  question  String
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  planId  String
  plan    Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  options PollOption[]
}

model PollOption {
  id   String @id @default(cuid())
  text String

  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  userId       String
  pollOptionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)

  @@id([userId, pollOptionId])
}

model BringItem {
  id        String  @id @default(cuid())
  label     String
  claimedBy String?

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// Compteurs anonymes par jour : visites des pages publiques (page = 'decouvrir',
// 'brochure') et messages envoyés (page = 'messages', lib/activity.ts) — uniquement
// un total par jour, ni cookie, ni IP, ni identifiant, ni contenu.
model PageVisit {
  page  String
  day   DateTime @db.Date
  count Int      @default(0)

  @@id([page, day])
}

// Signalement d'un message (chat d'un Plan ou d'un sondage), traité dans le panneau admin
// (lib/moderation.ts). Le texte est copié au moment du signalement, chiffré comme les messages,
// pour rester lisible même si l'auteur le modifie ou le supprime ; effacé au traitement.
model MessageReport {
  id         String    @id @default(cuid())
  kind       String // plan | poll
  messageId  String
  planId     String?
  pollId     String?
  content    String // copie chiffrée (encryptMessage)
  reason     String?
  reporterId String
  reporter   User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolution String? // deleted | dismissed

  @@unique([reporterId, kind, messageId])
  @@index([resolvedAt])
}

// « Masquer » une personne : ses messages n'apparaissent plus pour blockerId et elle ne lui
// envoie plus de notifications (lib/moderation.ts). Invisible pour la personne masquée.
model UserBlock {
  blockerId String
  blocker   User     @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Invitation d'un compte EvLY existant dans un Cercle (par pseudo ou email exact). La personne
// accepte ou refuse ; en acceptant, elle suit les mêmes règles qu'avec le code (entrée directe
// si le Cercle est ouvert, sinon demande d'adhésion — voix de la personne qui invite comptée).
model CircleInvitation {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User     @relation("InviteFrom", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User     @relation("InviteTo", fields: [inviteeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([circleId, inviteeId])
  @@index([inviteeId])
}

// Historique des modifications d'un Cercle (nom, description, paramètres), visible des membres
// dans les paramètres du Cercle — même principe que PlanChangeLog
model CircleChangeLog {
  id          String   @id @default(cuid())
  circleId    String
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  field       String
  oldValue    String?
  newValue    String?
  changedAt   DateTime @default(now())
  changedById String?
  changedBy   User?    @relation("CircleChangeLogAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([circleId])
}

// « Proposer une amélioration » (menu ☰) : idée, problème ou autre, suivi dans le panneau
// admin. La personne est notifiée quand sa suggestion passe en « Prévu » ou « Réalisé ».
// Supprimée avec le compte.
model Suggestion {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // idea | bug | other
  content    String
  platform   String? // web | android | ios
  appVersion String?
  status     String   @default("new") // new | review | planned | done | declined
  reply      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
