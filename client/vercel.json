{
  "redirects": [
    {
      "source": "/brochure",
      "destination": "https://junto-production-8ded.up.railway.app/api/stats/go/brochure",
      "permanent": false
    },
    {
      "source": "/evly-associations-entreprises.pdf",
      "destination": "https://junto-production-8ded.up.railway.app/api/stats/go/brochure",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/invitation",
      "destination": "https://junto-production-8ded.up.railway.app/api/share/invitation"
    },
    {
      "source": "/apercu/:file",
      "destination": "https://junto-production-8ded.up.railway.app/api/share/image/:file"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
